generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum TournamentFormat {
  SOLO
  DUO
  SQUAD
  TEAM
}

enum TournamentStatus {
  DRAFT
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  LIVE
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum TournamentResultStatus {
  DRAFT
  VERIFIED
  DISQUALIFIED
}

enum TournamentPrizeStatus {
  DRAFT
  FINALIZED
}

enum TournamentPrizeSettlementStatus {
  PENDING
  APPROVED
  CREDITED
  CANCELLED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionCategory {
  PRIZE
  REFUND
  WITHDRAWAL
  ENTRY_FEE
  ADJUSTMENT
}

enum WalletReferenceType {
  PRIZE_SETTLEMENT
  REFUND
  WITHDRAWAL
  ENTRY_PAYMENT
  ADJUSTMENT
}

enum WithdrawalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayoutDestinationType {
  UPI
  BANK_ACCOUNT
}

enum PayoutDestinationStatus {
  PENDING_VERIFICATION
  VERIFIED
  DISABLED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String?
  email String @unique
  phone String? @db.VarChar(20)
  emailVerified DateTime?
  image String?
  role UserRole @default(USER)
  status UserStatus @default(ACTIVE)
  accounts Account[]
  sessions Session[]
  registrations Registration[]
  wallet Wallet?
  withdrawalRequests WithdrawalRequest[]
  reviewedWithdrawals WithdrawalRequest[] @relation("WithdrawalReviewer")
  payoutDestinations PayoutDestination[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id String @id @default(cuid())
  userId String @db.Uuid
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String @db.Uuid
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}

model Game {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  code String @unique
  description String? @db.Text
  logoUrl String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tournaments Tournament[]
}

model Tournament {
  id String @id @default(uuid()) @db.Uuid
  gameId String @db.Uuid
  name String
  slug String @unique
  description String? @db.Text
  rules String? @db.Text
  bannerUrl String?
  startTime DateTime
  registrationStartTime DateTime?
  registrationEndTime DateTime?
  entryFee Decimal @default(0) @db.Decimal(12, 2)
  prizePool Decimal @default(0) @db.Decimal(12, 2)
  maxParticipants Int?
  tournamentFormat TournamentFormat
  region String
  status TournamentStatus @default(DRAFT)
  joiningWindowMinutes Int @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)
  registrations Registration[]
  results TournamentResult[]
  room TournamentRoom?
  prizes TournamentPrize[]
  settlements TournamentPrizeSettlement[]
  @@index([gameId])
  @@index([status])
  @@index([startTime])
  @@index([registrationStartTime])
  @@index([registrationEndTime])
}

model Registration {
  id String @id @default(uuid()) @db.Uuid
  tournamentId String @db.Uuid
  userId String @db.Uuid
  status RegistrationStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments Payment[]
  code RegistrationCode?
  result TournamentResult?
  settlements TournamentPrizeSettlement[]
  @@unique([userId, tournamentId])
  @@index([tournamentId])
  @@index([userId])
  @@index([tournamentId, status])
}

model RegistrationCode {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @unique @db.Uuid
  codeHash String @unique @db.Char(64)
  codeEncrypted String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revokedAt DateTime?
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  @@index([revokedAt])
}

model TournamentRoom {
  id String @id @default(uuid()) @db.Uuid
  tournamentId String @unique @db.Uuid
  roomIdEncrypted String @db.Text
  roomPasswordEncrypted String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  revokedAt DateTime?
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  @@index([publishedAt])
  @@index([revokedAt])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  merchantTransactionId String @unique
  payuTransactionId String?
  amount Decimal @db.Decimal(12, 2)
  currency String @default("INR") @db.VarChar(3)
  status PaymentStatus @default(INITIATED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  @@index([registrationId])
  @@index([status])
  @@index([registrationId, status])
}

model TournamentResult {
  id String @id @default(uuid()) @db.Uuid
  tournamentId String @db.Uuid
  registrationId String @unique @db.Uuid
  rank Int
  score Decimal @db.Decimal(20, 6)
  resultStatus TournamentResultStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  settlement TournamentPrizeSettlement?
  @@index([tournamentId, rank])
  @@index([tournamentId, resultStatus])
}

model TournamentPrize {
  id String @id @default(uuid()) @db.Uuid
  tournamentId String @db.Uuid
  rank Int
  amount Decimal @db.Decimal(12, 2)
  status TournamentPrizeStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  settlement TournamentPrizeSettlement?
  @@unique([tournamentId, rank])
  @@index([tournamentId])
}

model TournamentPrizeSettlement {
  id String @id @default(uuid()) @db.Uuid
  tournamentId String @db.Uuid
  prizeId String @unique @db.Uuid
  registrationId String @db.Uuid
  resultId String @unique @db.Uuid
  rank Int
  amount Decimal @db.Decimal(12, 2)
  currency String @default("INR") @db.VarChar(3)
  status TournamentPrizeSettlementStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  prize TournamentPrize @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  result TournamentResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  @@index([tournamentId, status])
  @@index([registrationId])
}

model Wallet {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  currency String @default("INR") @db.VarChar(3)
  balance Decimal @default(0) @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]
  @@index([createdAt])
}

model WalletTransaction {
  id String @id @default(uuid()) @db.Uuid
  walletId String @db.Uuid
  type WalletTransactionType
  category WalletTransactionCategory
  amount Decimal @db.Decimal(20, 2)
  currency String @db.VarChar(3)
  referenceType WalletReferenceType
  referenceId String @db.Uuid
  description String? @db.Text
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  @@unique([walletId, referenceType, referenceId, type, category])
  @@index([walletId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

model WithdrawalRequest {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  walletId String @db.Uuid
  payoutDestinationId String? @db.Uuid
  destinationTypeSnapshot PayoutDestinationType?
  destinationMaskedSnapshot String? @db.VarChar(64)
  encryptedDestinationSnapshot String? @db.Text
  amount Decimal @db.Decimal(20, 2)
  currency String @default("INR") @db.VarChar(3)
  status WithdrawalRequestStatus @default(PENDING)
  idempotencyKey String? @db.VarChar(128)
  rejectionReason String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviewedAt DateTime?
  reviewedById String? @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  payoutDestination PayoutDestination? @relation(fields: [payoutDestinationId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([walletId])
  @@index([payoutDestinationId])
  @@index([status])
  @@index([createdAt])
}

model PayoutDestination {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  type PayoutDestinationType
  status PayoutDestinationStatus @default(PENDING_VERIFICATION)
  displayName String @db.VarChar(100)
  maskedDestination String @db.VarChar(64)
  encryptedDestinationData String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  verifiedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  withdrawals WithdrawalRequest[]
  @@index([userId, status])
  @@index([createdAt])
}
