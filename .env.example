# Application
APP_ENVIRONMENT=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata

# PostgreSQL / Prisma (server-only)
DATABASE_URL=

# Auth.js / Google OAuth (server-only)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PayU hosted checkout (server-only; never expose the salt)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=test

# Protected scheduler/lifecycle endpoint (server-only)
CRON_SECRET=

# Payout destination encryption (server-only; base64-encoded 32-byte key)
PAYOUT_ENCRYPTION_KEY=

# PayU Payouts (server-only; use TEST/UAT outside production)
PAYU_PAYOUT_ENVIRONMENT=TEST
PAYU_PAYOUT_MERCHANT_ID=
PAYU_PAYOUT_CLIENT_ID=
PAYU_PAYOUT_CLIENT_SECRET=
PAYU_PAYOUT_WEBHOOK_SECRET=
# Production requires both this and PAYOUTS_ENABLED=true.
PAYU_PAYOUT_PRODUCTION_ENABLED=false

# Emergency payout kill switch. Outside production, omission/true keeps payouts enabled.
PAYOUTS_ENABLED=true
