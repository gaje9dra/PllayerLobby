# Application
APP_ENVIRONMENT=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata

# PostgreSQL / Prisma (server-only)
DATABASE_URL=

# Auth.js / Google OAuth (server-only)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PayU hosted checkout (server-only; never expose the salt)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=test

# Protected scheduler/lifecycle endpoint (server-only)
CRON_SECRET=

# Payout destination encryption (server-only; 32 random bytes as 64-char hex or Base64/Base64URL)
PAYOUT_ENCRYPTION_KEY=

# Optional PayU Payouts API (only needed if you automate bank/UPI transfers through PayU).
# Leave these unset for the manual admin withdrawal workflow.
PAYU_PAYOUT_ENVIRONMENT=TEST
PAYU_PAYOUT_MERCHANT_ID=
PAYU_PAYOUT_CLIENT_ID=
PAYU_PAYOUT_CLIENT_SECRET=
PAYU_PAYOUT_WEBHOOK_SECRET=
PAYU_PAYOUT_PRODUCTION_ENABLED=false

# Automated PayU payout kill switch. Defaults to disabled in production when omitted.
PAYOUTS_ENABLED=false
